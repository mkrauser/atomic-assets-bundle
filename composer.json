{
  "name": "mak/atomic-assets-bundle",
  "type": "symfony-bundle",
  "description": "A Symfony bundle to use assets (js, images, css with css-modules) from within the template directory with twig and webpack encore",
  "keywords": ["twig", "css-modules", "bundle"],
  "homepage": "https://twig.symfony.com",
  "license": "MIT",
  "minimum-stability": "dev",
  "authors": [
    {
      "name": "Matthias Krauser",
      "email": "matthias@krauser.eu"
    }
  ],
  "require": {
    "php": ">=8.2",
    "symfony/asset": "^6.4|^7.0|^8.0",
    "symfony/config": "^6.4|^7.0|^8.0",
    "symfony/filesystem": "^6.4|^7.0|^8.0",
    "symfony/framework-bundle": "^6.4|^7.0|^8.0",
    "symfony/twig-bundle": "^6.4|^7.0|^8.0",
    "twig/twig": "^3.12"
  },
  "require-dev": {
    "rector/rector": "^2.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.2@dev",
    "symfony/asset-mapper": "^6.4|^7.0|^8.0"
  },
  "suggest": {
    "symfony/asset-mapper": "To serve the CSS modules without a bundler, see docs/asset-mapper.md"
  },
  "replace": {
    "mak/css-module-bundle": "@stable"
  },
  "autoload": {
    "psr-4" : { "Mak\\AtomicAssetsBundle\\" : "." },
    "exclude-from-classmap": [
      "/Tests/"
    ]
  },
  "conflicts": {
    "sensiolabs/storybook-bundle": "*"
  }
}
